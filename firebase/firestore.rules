rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /cofreUsers/{userId}/vault/main {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      allow read: if owner();
      allow create, update: if owner()
        && request.resource.data.keys().hasOnly(['encrypted', 'updatedAt'])
        && request.resource.data.encrypted is string
        && request.resource.data.encrypted.size() < 950000
        && request.resource.data.updatedAt == request.time;
      allow delete: if owner();
    }
  }
}
